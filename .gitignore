# ── Секреты ───────────────────────────────────────────────────────────────────
# НИКОГДА не коммитить — содержит пароли и JWT-ключ
settings.json

# ── Go ────────────────────────────────────────────────────────────────────────
# Скомпилированные бинарники
backend-go/fake-review-ai2
backend-go/fake-review-ai2.exe
backend-go/*.exe

# Кэш Go-инструментов
backend-go/vendor/

# ── Python ────────────────────────────────────────────────────────────────────
# Обученные модели (большие бинарные файлы — генерируются через train.py)
backend-python/models/*.h5
backend-python/models/*.pkl
backend-python/models/*.keras

# Датасет (скачивается через get_dataset.py)
backend-python/dataset/*.csv

# Стандартный Python-мусор
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/

# ── Node.js / TypeScript ──────────────────────────────────────────────────────
node_modules/

# Source maps — генерируются при компиляции TS
static/**/*.js.map
static/**/*.d.ts

# ── IDE и OS ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Бэкапы (созданные в ходе разработки) ─────────────────────────────────────
static/*.bak
static/**/*.bak

# ── Логи ─────────────────────────────────────────────────────────────────────
*.log
logs/
